{
  "name": "pdfshuffle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "tsc --noEmit",
