    "test:e2e": "playwright test",
    "serve": "node scripts/serve-static.mjs out"
  },
  "dependencies": {
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
